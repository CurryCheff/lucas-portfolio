# --- Admin auth ---
ADMIN_PASSWORD=
SUBMIT_LINK_SECRET=            # openssl rand -hex 32
SUBMIT_LINK_TTL_DAYS=30

# --- Supabase (service-role, server-side only — never expose to the browser) ---
# Project: overboard-testimonials (https://ahpkghugiriaezswryfs.supabase.co)
# Get the service_role key from: Supabase dashboard -> this project -> Project Settings -> API -> service_role (secret)
SUPABASE_URL=https://ahpkghugiriaezswryfs.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# --- GitHub (fine-grained PAT, scoped to CurryCheff/lucas-portfolio only —
#     Contents + Pull requests + Metadata permissions) ---
GITHUB_TOKEN=
GITHUB_REPO_OWNER=CurryCheff
GITHUB_REPO_NAME=lucas-portfolio
GITHUB_BASE_BRANCH=main

# --- Gemini (existing var, reused by the thank-you generator in api/chat.js too) ---
GEMINI_API_KEY=

# --- Resend (thank-you email) ---
RESEND_API_KEY=
RESEND_FROM_EMAIL=             # e.g. "Overboard <hello@yourdomain.com>" — must be a verified Resend sender

# --- WhatsApp (local open-wa companion service — see whatsapp-service/README.md) ---
WHATSAPP_SERVICE_URL=          # e.g. https://<cloudflared-hostname>/send
WHATSAPP_SHARED_SECRET=        # must match WA_SHARED_SECRET in whatsapp-service/.env

# --- Misc ---
PUBLIC_SITE_URL=               # e.g. https://overboard.dev — used to build submission links; falls back to the request host if unset
